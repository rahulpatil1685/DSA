        switch (choice) 
        {
            case 1:
                printf("Enter parcel number to add: ");
                scanf("%d", &parcelNumber);
                addParcel(parcelNumber);
                break;
            case 2:
                removeParcel();
                break;
            case 3:
                displayParcels();
                break;
            case 4:
                printf("Exiting parcel handling system.\n");
                break;
            default:
                printf("Invalid choice! Please enter between 1-4.\n");
        }
    } while (choice != 4);

    return 0;
